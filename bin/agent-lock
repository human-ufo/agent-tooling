#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# agent-lock v2 — Coordinación advisory entre sesiones de agentes, con alcance.
#
# Mejoras sobre v1, a partir de un incidente real del 2026-10-21 en el que dos
# sesiones sobre el mismo clon se pisaron el trabajo sin commitear:
#
# 1. Alcance por rama. v1 tomaba el repo entero, así que dos sesiones que
#    trabajan en ramas distintas se bloqueaban entre sí sin necesidad. v2
#    registra la rama y el worktree, y `check` dice si el conflicto es real.
# 2. `release` de un lock ajeno FALLA. v1 lo liberaba igual, avisando por
#    stderr. Con el aviso por stderr y un código de salida 0, cualquiera que
#    no leyera el stderr liberaba el lock de otro. v2 se niega y exige
#    --force explícito.
# 3. TTL por defecto de 90 minutos, con `--ttl` para extenderlo. v1 usaba
#    240 minutos: un lock olvidado bloqueaba el repo medio día.
# 4. `--session` para distinguir dos sesiones del mismo agente.
#
# Sigue siendo advisory: avisa, no bloquea por la fuerza. La barrera real de
# escritura es el aislamiento por worktree (agent-worktree) y el hook
# pre-push, que sí niegan la operación.
#
# Uso:
#   agent-lock acquire <repo> --agent <nombre> [--note "tarea"] [--ttl <min>]
#                 [--session <id>] [--branch <rama>] [--worktree <ruta>] [--force]
#   agent-lock release <repo> --agent <nombre> [--session <id>] [--force]
#   agent-lock check  <repo> [--branch <rama>] [--session <id>]
#   agent-lock list
#
# Estado: ~/.cache/agent-locks/<repo>.lock  (JSON, TTL por archivo).
# -----------------------------------------------------------------------------
set -Eeuo pipefail

lockdir="${AGENT_LOCK_DIR:-${HOME}/.cache/agent-locks}"
mkdir -p "$lockdir"
default_ttl_min=90

slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
now_epoch() { date +%s; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
usage() { awk 'NR>1 && /^set -Eeuo/ {exit} NR>1 {print}' "$0"; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

cmd="${1:-list}"
shift || true

repo=""
agent="${AGENT_NAME:-$(whoami)}"
note=""
ttl="$default_ttl_min"
session=""
branch=""
worktree=""
force=false

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)    agent="${2:-}"; shift 2 ;;
    --note)     note="${2:-}"; shift 2 ;;
    --ttl)      ttl="${2:-$default_ttl_min}"; shift 2 ;;
    --session)  session="${2:-}"; shift 2 ;;
    --branch)   branch="${2:-}"; shift 2 ;;
    --worktree) worktree="${2:-}"; shift 2 ;;
    --force)    force=true; shift ;;
    -h|--help)  usage; exit 0 ;;
    *) if [ -z "$repo" ]; then repo="$1"; shift; else echo "arg extra: $1" >&2; exit 2; fi ;;
  esac
done

require_repo() { [ -n "$repo" ] || { echo "falta <repo>" >&2; exit 2; }; }

is_expired() {
  [ -f "$1" ] || return 0
  local exp; exp="$(jq -r '.expires_epoch // 0' "$1" 2>/dev/null || echo 0)"
  [ "$(now_epoch)" -ge "$exp" ] && return 0 || return 1
}

held_minutes() {
  local acq acq_epoch
  acq="$(jq -r '.acquired // empty' "$1" 2>/dev/null || true)"
  [ -n "$acq" ] || { printf '?'; return 0; }
  acq_epoch="$(date -u -d "$acq" +%s 2>/dev/null || true)"
  [ -n "$acq_epoch" ] || { printf '?'; return 0; }
  printf '%s' "$(( ( $(now_epoch) - acq_epoch ) / 60 ))"
}

describe_lock() {
  jq -r --arg held "$2" \
    '"  agente=\(.agent)  sesion=\(.session // "-")  rama=\(.branch // "-")  desde=\(.acquired)  hace \($held) min  nota=\(.note // "-")  expira=\(.expires_iso)"' "$1"
}

write_lock() {
  local exp_epoch exp_iso
  exp_epoch=$(( $(now_epoch) + ttl*60 ))
  exp_iso="$(date -u -d "@${exp_epoch}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || now_iso)"
  jq -nc --arg repo "$repo" --arg agent "$agent" --arg note "$note" \
     --arg session "$session" --arg branch "$branch" --arg worktree "$worktree" \
     --arg ts "$(now_iso)" --argjson ee "$exp_epoch" --arg ei "$exp_iso" \
     '{repo:$repo, agent:$agent, session:$session, branch:$branch, worktree:$worktree,
       note:$note, acquired:$ts, expires_epoch:$ee, expires_iso:$ei}' > "$1"
  printf '%s' "$exp_iso"
}

case "$cmd" in
  acquire)
    require_repo
    f="${lockdir}/$(slug "$repo").lock"
    if ! is_expired "$f"; then
      if [ "$force" != "true" ]; then
        echo "agent-lock: '${repo}' ya está tomado:" >&2
        describe_lock "$f" "$(held_minutes "$f")" >&2
        if [ -n "$branch" ]; then
          other="$(jq -r '.branch // empty' "$f")"
          if [ -n "$other" ] && [ "$other" != "$branch" ]; then
            echo "  El lock es de la rama '${other}', distinta de '${branch}': no hay conflicto real." >&2
            echo "  Podés trabajar en paralelo con --force, o esperar a que se libere." >&2
          fi
        fi
        echo "  Si es tuyo de una sesión previa: 'agent-lock release ${repo} --agent ${agent}'." >&2
        echo "  Si es de otra sesión y comprobaste que está muerta: 'agent-lock acquire ${repo} --force'." >&2
        exit 1
      fi
      echo "agent-lock: --force sobre lock vivo, dueño anterior:" >&2
      describe_lock "$f" "$(held_minutes "$f")" >&2
    fi
    exp_iso="$(write_lock "$f")"
    echo "agent-lock: '${repo}' tomado por '${agent}' hasta ${exp_iso}."
    [[ -n "$branch" ]] && echo "  rama:    ${branch}"
    [[ -n "$session" ]] && echo "  sesion:  ${session}"
    ;;
  release)
    require_repo
    f="${lockdir}/$(slug "$repo").lock"
    if [ ! -f "$f" ]; then echo "agent-lock: '${repo}' no estaba tomado."; exit 0; fi
    owner="$(jq -r '.agent // "?"' "$f" 2>/dev/null || echo '?')"
    other_session="$(jq -r '.session // ""' "$f" 2>/dev/null || echo '')"
    if [ "$owner" != "$agent" ]; then
      if [ "$force" != "true" ]; then
        echo "agent-lock: '${repo}' está tomado por '${owner}', no por '${agent}'." >&2
        describe_lock "$f" "$(held_minutes "$f")" >&2
        echo "  No lo libero. Si la sesión dueña está muerta: 'agent-lock release ${repo} --force'." >&2
        exit 1
      fi
      echo "agent-lock: --force liberando el lock de '${owner}'." >&2
    elif [ -n "$session" ] && [ -n "$other_session" ] && [ "$other_session" != "$session" ]; then
      if [ "$force" != "true" ]; then
        echo "agent-lock: '${repo}' está tomado por la sesión '${other_session}' de '${agent}'." >&2
        describe_lock "$f" "$(held_minutes "$f")" >&2
        echo "  No lo libero. Si esa sesión terminó: 'agent-lock release ${repo} --force'." >&2
        exit 1
      fi
      echo "agent-lock: --force liberando el lock de la sesión '${other_session}'." >&2
    fi
    rm -f "$f"
    echo "agent-lock: '${repo}' liberado."
    ;;
  check)
    require_repo
    f="${lockdir}/$(slug "$repo").lock"
    if is_expired "$f"; then
      echo "agent-lock: '${repo}' LIBRE."
      exit 0
    fi
    echo "agent-lock: '${repo}' TOMADO:"
    describe_lock "$f" "$(held_minutes "$f")"
    if [ -n "$branch" ]; then
      other="$(jq -r '.branch // empty' "$f")"
      if [ -n "$other" ] && [ "$other" != "$branch" ]; then
        echo "  Sin conflicto real: el lock es de la rama '${other}' y vos estás en '${branch}'."
        exit 0
      fi
    fi
    exit 1
    ;;
  list)
    echo "=== PIZARRA de repos tomados (agent-lock) ==="
    found=0
    for f in "$lockdir"/*.lock; do
      [ -e "$f" ] || continue
      if is_expired "$f"; then rm -f "$f"; continue; fi
      found=1
      jq -r '"\(.repo)  ->  agente=\(.agent)  sesion=\(.session // "-")  rama=\(.branch // "-")  nota=\(.note // "-")  expira=\(.expires_iso)"' "$f"
    done
    if [ "$found" = "0" ]; then echo "(ninguno — todos libres)"; fi
    ;;
  *)
    echo "comando desconocido: $cmd (acquire|release|check|list)" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# agent-worktree — Aislamiento de escritura por sesión.
#
# Problema que resuelve: varias sesiones de agentes comparten un mismo clon y
# se pisan. El síntoma no es "dos pushes a main": es que una sesión corre
# `git stash`, `git checkout -- .` o `git reset --hard` sobre el trabajo sin
# commitear de otra. Ningún lock advisory evita eso, porque el daño ocurre en
# el working tree, no en el remoto.
#
# Solución: un worktree por sesión. Cada sesión trabaja en su propio árbol de
# trabajo, con su propia rama, y Git impide que dos worktrees revisen la misma
# rama. Con eso, `git stash`, `git checkout -- .` y `git reset --hard` de una
# sesión no alcanzan el trabajo de otra.
#
# El aislamiento es local y no necesita branch protection del remoto: es una
# garantía del sistema de archivos, no una convención social.
#
# Uso:
#   agent-worktree open <repo> --agent <nombre> [--session <id>] [--branch <rama>]
#       Crea el worktree de la sesión y lo deja como directorio de trabajo.
#       Imprime la ruta. Falla si la sesión ya tiene uno abierto.
#   agent-worktree list [<repo>]
#       Lista los worktrees de las sesiones y quién los tiene tomado.
#   agent-worktree close <repo> --agent <nombre> [--session <id>] [--force]
#       Cierra el worktree. Con cambios sin commitear se niega, salvo --force.
#   agent-worktree path <repo> --agent <nombre> [--session <id>]
#       Imprime la ruta del worktree de la sesión, sin crearlo.
#
# --session identifica la sesión dentro del agente: por defecto es el PID, para
# que dos sesiones del mismo agente no compartan worktree.
#
# Estado: ~/.cache/agent-worktrees/<repo>.json  (JSON, un registro por sesión)
# Worktrees: <repo>/.worktrees/<session>/   (dentro del clon, gitignored)
# -----------------------------------------------------------------------------
set -Eeuo pipefail

statedir="${AGENT_WORKTREE_DIR:-${HOME}/.cache/agent-worktrees}"
default_branch_base="agent"

usage() { awk 'NR>1 && /^set -Eeuo/ {exit} NR>1 {print}' "$0"; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

cmd="${1:-list}"
shift || true

repo=""
agent="${AGENT_NAME:-$(whoami)}"
session=""
branch=""
force=false

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)   agent="${2:-}"; shift 2 ;;
    --session) session="${2:-}"; shift 2 ;;
    --branch)  branch="${2:-}"; shift 2 ;;
    --force)   force=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) if [ -z "$repo" ]; then repo="$1"; shift; else echo "arg extra: $1" >&2; exit 2; fi ;;
  esac
done

require_repo() { [ -n "$repo" ] || { echo "falta <repo>" >&2; exit 2; }; }
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

statefile() { printf '%s/%s.json' "$statedir" "$(slug "$repo")"; }

resolve_repo() {
  # Acepta un path, un nombre de repo relativo al home, o un slug.
  if [ -d "$repo/.git" ] || [ -f "$repo/.git" ]; then
    repo="$(cd "$repo" && pwd)"
  elif [ -d "${HOME}/Documents/${repo}" ]; then
    repo="${HOME}/Documents/${repo}"
  elif [ -d "${HOME}/${repo}" ]; then
    repo="${HOME}/${repo}"
  else
    echo "agent-worktree: no encuentro el repo '${repo}'." >&2
    exit 2
  fi
}

default_session() { printf '%s-%s' "$(slug "$agent")" "$$"; }

worktree_root() { printf '%s/.worktrees' "$repo"; }

read_state() {
  local f; f="$(statefile)"
  [ -f "$f" ] || { printf '[]'; return 0; }
  jq -c '.' "$f" 2>/dev/null || printf '[]'
}

write_state() {
  # $1 = json completo
  mkdir -p "$statedir"
  printf '%s' "$1" > "$(statefile).tmp"
  mv "$(statefile).tmp" "$(statefile)"
}

session_id() { printf '%s' "${session:-$(default_session)}"; }

find_record() {
  # $1 = session id. Imprime el registro JSON o nada.
  read_state | jq -c --arg s "$(session_id)" '.[] | select(.session == $s)' | head -1
}

ensure_ignored() {
  # El directorio de worktrees no debe aparecer como untracked del clon.
  # El exclude vive en info/exclude, que es comun a todos los worktrees.
  # La barra final es la que hace que git ignore el DIRECTORIO y no un archivo
  # con ese nombre.
  local rel; rel="$(basename "$(worktree_root)")"
  # --git-path devuelve una ruta relativa al worktree consultado, que no es
  # la del clon principal. Hay que resolverla contra el directorio comun.
  # La ruta del exclude se resuelve SIEMPRE contra el directorio comun de
  # git, porque --git-path devuelve una ruta relativa al worktree consultado.
  local gi
  gi="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$gi")"
  if ! grep -qxF "${rel}/" "$gi" 2>/dev/null; then
    printf '%s/\n' "$rel" >> "$gi"
  fi
}

case "$cmd" in
  open)
    require_repo
    resolve_repo
    mkdir -p "$statedir"
    local_sid="$(session_id)"
    rec="$(find_record "$local_sid")"
    if [ -n "$rec" ]; then
      p="$(printf '%s' "$rec" | jq -r '.path')"
      if [ -d "$p" ]; then
        echo "agent-worktree: la sesión '${local_sid}' ya tiene el worktree abierto en ${p}"
        exit 0
      fi
    fi
    root="$(worktree_root)"
    mkdir -p "$root"
    ensure_ignored
    path="${root}/${local_sid}"
    if [ -z "$branch" ]; then
      # El sufijo de PID evita que dos aperturas en el mismo segundo colisionen.
      branch="${default_branch_base}/$(slug "$agent")/$(date -u +%Y%m%d-%H%M%S)-$$"
    fi
    if git -C "$repo" show-ref --verify --quiet "refs/heads/${branch}"; then
      echo "agent-worktree: la rama '${branch}' ya existe. Elegí otra con --branch." >&2
      exit 1
    fi
    base="origin/main"
    git -C "$repo" rev-parse --verify --quiet "${base}" >/dev/null || base="HEAD"
    if ! git -C "$repo" worktree add -b "$branch" "$path" "$base" >/dev/null 2>&1; then
      echo "agent-worktree: no pude crear el worktree en ${path}." >&2
      exit 1
    fi
    newrec="$(jq -nc --arg s "$local_sid" --arg a "$agent" --arg r "$repo" \
      --arg p "$path" --arg b "$branch" --arg t "$(now_iso)" \
      '{session:$s, agent:$a, repo:$r, path:$p, branch:$b, opened_at:$t}')"
    write_state "$(read_state | jq -c --arg s "$local_sid" '[.[] | select(.session != $s)]' | jq -c --argjson n "$newrec" '. + [$n]')"
    echo "agent-worktree: sesión '${local_sid}' abierta."
    echo "  rama:    ${branch}"
    echo "  ruta:    ${path}"
    echo "  base:    ${base}"
    echo ""
    echo "Trabajá dentro de esa ruta. 'git status' y 'git add' de otra sesión ya no alcanzan este árbol."
    ;;
  list)
    require_repo
    resolve_repo
    printf '=== WORKTREES DE SESIÓN (%s) ===\n' "$repo"
    if [ -d "$(worktree_root)" ]; then
      git -C "$repo" worktree list | sed 's/^/  /'
    else
      echo "  (ninguno)"
    fi
    printf '  --- registro de sesiones ---\n'
    read_state | jq -r '.[] | "  \(.session)  agente=\(.agent)  rama=\(.branch)  \(.path)"'
    ;;
  path)
    require_repo
    resolve_repo
    rec="$(find_record "$(session_id)")"
    if [ -z "$rec" ]; then
      echo "agent-worktree: la sesión '$(session_id)' no tiene worktree abierto." >&2
      exit 1
    fi
    printf '%s' "$rec" | jq -r '.path'
    ;;
  close)
    require_repo
    resolve_repo
    rec="$(find_record "$(session_id)")"
    if [ -z "$rec" ]; then
      echo "agent-worktree: la sesión '$(session_id)' no tiene worktree abierto." >&2
      exit 1
    fi
    p="$(printf '%s' "$rec" | jq -r '.path')"
    b="$(printf '%s' "$rec" | jq -r '.branch')"
    if [ -d "$p" ]; then
      if [ -n "$(git -C "$p" status --porcelain 2>/dev/null)" ] && [ "$force" != "true" ]; then
        echo "agent-worktree: el worktree ${p} tiene cambios sin commitear." >&2
        echo "  Commitealos, o cerralo con --force para descartarlos." >&2
        exit 1
      fi
      git -C "$repo" worktree remove --force "$p" >/dev/null 2>&1 || true
    fi
    git -C "$repo" branch -D "$b" >/dev/null 2>&1 || true
    write_state "$(read_state | jq -c --arg s "$(session_id)" '[.[] | select(.session != $s)]')"
    echo "agent-worktree: sesión '$(session_id)' cerrada."
    ;;
  *)
    echo "comando desconocido: $cmd (open|list|path|close)" >&2; exit 2 ;;
esac
